{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weblate's REST addons tasks API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "api_tasks_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/tasks/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return information about a task"
        },
        {
          "info": {
            "name": "api_tasks_destroy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http:/api/tasks/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}