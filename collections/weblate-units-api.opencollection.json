{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weblate's REST addons units API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "units",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "api_units_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/units/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return a list of translation units."
        },
        {
          "info": {
            "name": "api_units_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/units/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return information about translation unit."
        },
        {
          "info": {
            "name": "api_units_update",
