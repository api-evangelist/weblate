{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weblate's REST addons API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "addons",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "api_addons_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/addons/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return a list of add-ons."
        },
        {
          "info": {
            "name": "api_addons_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/addons/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Returns information about add-on information."
        },
        {
          "info": {
            "name": "api_addons_update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http:/api/addons/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Edit full information about add-on."
        },
        {
          "info": {
            "name": "api_addons_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http:/api/addons/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Edit partial information about add-on."
        },
        {
          "info": {
            "name": "api_addons_destroy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http:/api/addons/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Delete add-on."
        },
        {
          "info": {
            "name": "api_addons_trigger_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http:/api/addons/:id/trigger/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Trigger manual execution of an add-on that supports manual triggering."
        }
      ]
    }
  ],
  "bundled": true
}