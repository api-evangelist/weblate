{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weblate's REST addons languages API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "languages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "api_languages_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/languages/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return a list of all languages the user has access to."
        },
        {
          "info": {
            "name": "api_languages_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http:/api/languages/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Create a new language."
        },
        {
          "info": {
            "name": "api_languages_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/languages/:code/",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return information about a language."
        },
        {
          "info": {
            "name": "api_languages_update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http:/api/languages/:code/",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Change the language parameters."
        },
        {
          "info": {
            "name": "api_languages_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http:/api/languages/:code/",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Change the language parameters."
        },
        {
          "info": {
            "name": "api_languages_destroy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http:/api/languages/:code/",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Delete the language."
        },
        {
          "info": {
            "name": "api_languages_statistics_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http:/api/languages/:code/statistics/",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Token",
              "value": "{{Token}}",
              "placement": "header"
            }
          },
          "docs": "Return statistics for a language."
        }
      ]
    }
  ],
  "bundled": true
}